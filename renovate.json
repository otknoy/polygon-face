{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "expo-*",
        "@expo/*",
        "react",
        "react-dom",
        "react-native",
        "react-native-*",
        "@types/react",
        "@types/jest",
        "typescript",
        "eslint",
        "eslint-config-expo",
        "jest",
        "jest-expo"
      ],
      "enabled": false
    }
  ]
}
